# ==========================================
# CONNECTLIVE ADMIN PANEL - ENV CONFIGURATION
# ==========================================

# Server
PORT=3000
NODE_ENV=production
# Required so Nitro builds a Node server instead of the default Cloudflare Workers preset
NITRO_PRESET=node-server

# Supabase - client (Vite-injected at build time)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=your-project-id

# Supabase - server (read inside server functions / routes)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Optional TURN/STUN for WebRTC live sessions
# TURN_SERVER_URL=turn:your-turn-server.com:3478
# TURN_SERVER_USER=username
# TURN_SERVER_SECRET=secret
