# ==========================================
# CONNECTLIVE ADMIN PANEL - ENV CONFIGURATION
# ==========================================

# Server
PORT=3000
NODE_ENV=production
# Required so Nitro builds a Node server instead of the default Cloudflare Workers preset
NITRO_PRESET=node-server

# Supabase - client (Vite-injected at build time)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=your-project-id

# Supabase - server (read inside server functions / routes)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Lovable AI Gateway (auto-provisioned in Lovable Cloud)
LOVABLE_API_KEY=lov_xxx

# ==========================================
# Agent enrollment
# ==========================================
# The agent enrolls keylessly: POST /api/public/agent/enroll is IP rate-limited
# and issues a per-device token that the agent stores DPAPI-encrypted at
# %LOCALAPPDATA%\ConnectLive\device.dat. There is no deployment key and no
# watcher/helper service any more.
# Bootstrap token gate for first-admin provisioning (/api/public/admin/bootstrap).
BOOTSTRAP_TOKEN=replace-with-strong-random-string

# ==========================================
# SMTP (built-in sender)
# ==========================================
# When set, these are used for all outgoing mail (orders, contact form,
# newsletter, portal alerts) with no admin-console input required. An enabled
# row saved in Payments -> Email overrides these.
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USERNAME=support@connectliveagent.com
SMTP_PASSWORD=replace-with-mailbox-password
SMTP_FROM_ADDRESS=support@connectliveagent.com
SMTP_FROM_NAME=ConnectLive
# Optional. Defaults: reply-to = from address, encryption inferred from port
# (465 -> ssl, 25 -> none, otherwise starttls).
# SMTP_REPLY_TO=support@connectliveagent.com
# SMTP_ENCRYPTION=starttls

# ==========================================
# Payments - Coinbase CDP
# ==========================================
# Server API key downloaded from Coinbase Developer Platform (Ed25519).
# Name shape: organizations/<uuid>/apiKeys/<uuid>
CDP_API_KEY_NAME=organizations/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/apiKeys/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Base64 Ed25519 private key (decodes to exactly 64 bytes).
CDP_API_KEY_PRIVATE_KEY=base64-ed25519-private-key
# HMAC secret configured on the Coinbase webhook endpoint; verifies /api/public/webhooks/cdp signatures.
CDP_WEBHOOK_SECRET=replace-with-strong-random-string

# ==========================================
# Optional integrations
# ==========================================
# WebRTC relay (S9 — read by /api/public/agent/ice).
# Without a relay, peers behind symmetric NAT / corporate firewalls fall back
# to the slow HTTPS frame pump. Port 443 over TCP/TLS is mandatory to get
# through restrictive firewalls.

# Preferred: Cloudflare Calls TURN (managed anycast relay).
# Cloudflare dashboard -> Calls -> your app.
CLOUDFLARE_CALLS_APP_ID=your-calls-app-id
CLOUDFLARE_CALLS_APP_TOKEN=your-calls-app-token

# Fallback: self-hosted coturn, used only when Cloudflare Calls is unset/unavailable.
# Comma-separated; include a 443 TCP and a 443 TLS entry.
# TURN_URLS=turn:turn.yourdomain.com:443?transport=tcp,turns:turn.yourdomain.com:443?transport=tcp
# coturn `use-auth-secret` shared secret -> ephemeral REST credentials (preferred, 32+ random chars).
# TURN_STATIC_SECRET=replace-with-32-character-random-secret
# Static fallback, only used when TURN_STATIC_SECRET is unset.
# TURN_USERNAME=username
# TURN_PASSWORD=password

# Telegram notifications (per-admin values are also saved in DB via Settings)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
