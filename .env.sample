# ==========================================
# CONNECTLIVE ADMIN PANEL - ENV CONFIGURATION
# ==========================================

# Server
PORT=3000
NODE_ENV=production
# Required so Nitro builds a Node server instead of the default Cloudflare Workers preset
NITRO_PRESET=node-server

# Supabase - client (Vite-injected at build time)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=your-project-id

# Supabase - server (read inside server functions / routes)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Lovable AI Gateway (auto-provisioned in Lovable Cloud)
LOVABLE_API_KEY=lov_xxx

# ==========================================
# Agent enrollment
# ==========================================
# The agent enrolls keylessly: POST /api/public/agent/enroll is IP rate-limited
# and issues a per-device token that the agent stores DPAPI-encrypted at
# %LOCALAPPDATA%\ConnectLive\device.dat. There is no deployment key and no
# watcher/helper service any more.
# Bootstrap token gate for first-admin provisioning (/api/public/admin/bootstrap).
BOOTSTRAP_TOKEN=replace-with-strong-random-string

# ==========================================
# Payments - Coinbase CDP
# ==========================================
# Server API key downloaded from Coinbase Developer Platform (Ed25519).
# Name shape: organizations/<uuid>/apiKeys/<uuid>
CDP_API_KEY_NAME=organizations/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/apiKeys/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Base64 Ed25519 private key (decodes to exactly 64 bytes).
CDP_API_KEY_PRIVATE_KEY=base64-ed25519-private-key
# HMAC secret configured on the Coinbase webhook endpoint; verifies /api/public/webhooks/cdp signatures.
CDP_WEBHOOK_SECRET=replace-with-strong-random-string

# ==========================================
# Optional integrations
# ==========================================
# TURN/STUN for WebRTC live sessions (S9 — read by /api/public/agent/ice).
# Comma-separated TURN URLs. When unset the gateway returns STUN only.
# TURN_URLS=turn:your-turn-server.com:3478?transport=udp,turns:your-turn-server.com:5349?transport=tcp
# coturn `use-auth-secret` shared secret -> ephemeral REST credentials (preferred).
# TURN_STATIC_SECRET=replace-with-strong-random-string
# Static fallback, only used when TURN_STATIC_SECRET is unset.
# TURN_USERNAME=username
# TURN_PASSWORD=password

# Cloudflare Calls TURN (managed anycast relay, preferred over self-hosted coturn).
# Get these from Cloudflare dashboard → Calls → your app.
# CLOUDFLARE_CALLS_APP_ID=your-calls-app-id
# CLOUDFLARE_CALLS_APP_TOKEN=your-calls-app-token

# Telegram notifications (per-admin values are also saved in DB via Settings)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
