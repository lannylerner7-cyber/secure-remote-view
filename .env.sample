# TEMPLATE ONLY. Set values in Coolify; never commit a filled .env file.
# Application port: Coolify must route public HTTPS 443 to this container port.
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
NITRO_PRESET=node-server

# PUBLIC browser configuration: mark these as build-time arguments in Coolify.
VITE_SUPABASE_URL=https://esjlqcfcwewymmeghbvj.supabase.co
VITE_SUPABASE_PROJECT_ID=esjlqcfcwewymmeghbvj
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLIC_PUBLISHABLE_KEY

# Runtime only. These names are separate from VITE_*.
SUPABASE_URL=https://esjlqcfcwewymmeghbvj.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_SAME_PUBLIC_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_PRIVATELY_WITH_SERVICE_ROLE_KEY
SESSION_SECRET_KEY=REPLACE_PRIVATELY_WITH_EXISTING_ENCRYPTION_SECRET

# Runtime SMTP; use a sender verified with the provider.
SMTP_HOST=smtp.mx.cloudflare.net
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USERNAME=api_token
SMTP_PASSWORD=REPLACE_PRIVATELY_WITH_SMTP_PASSWORD
SMTP_FROM_ADDRESS=REPLACE_WITH_VERIFIED_SENDER
SMTP_FROM_NAME="ConnectLive Team"

# Cloudflare TURN key ID/token, not SFU app credentials.
CLOUDFLARE_CALLS_APP_ID=REPLACE_WITH_TURN_KEY_ID
CLOUDFLARE_CALLS_APP_TOKEN=REPLACE_PRIVATELY_WITH_TURN_TOKEN

# Do NOT deploy SUPABASE_MIGRATION_DATABASE_URL or initial-admin passwords as
# normal application configuration. No database migration runs at startup.
