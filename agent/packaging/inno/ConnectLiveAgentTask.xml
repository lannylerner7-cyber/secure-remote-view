<?xml version="1.0" encoding="UTF-16"?>
<!--
  ConnectLive Agent - ONLOGON Scheduled Task definition.

  NOTE: ConnectLiveSetup.iss currently builds this XML inline in [Code]
  (RegisterLogonTask) and does NOT read this template. This file is kept as a
  reference / for anyone who adopts the file-template form instead. If adopted,
  __AGENT_EXE__ is replaced at install time with the real installed path
  (C:\Program Files\ConnectLive\ConnectLive.exe) and the result must be written
  as UTF-16 LE (BOM) to satisfy schtasks /XML -- the same requirement the
  installer's StringToUtf16LE helper handles. The <URI> below is now
  \ConnectLiveAgent to match the /TN and /Delete task name used everywhere else.

  This is the THIRD, most-robust logon trigger. The Agent's StartupSelfHeal
  also writes the HKCU Run key and Startup-folder shortcut on every launch;
  this task covers the case where both of those have been removed.

  Key settings:
    - LogonTrigger: fires for ANY interactive user logon (all users).
    - RunLevel LeastPrivilege: runs asInvoker in the user's session (NOT
      elevated) so it matches the Agent's asInvoker manifest and never pops UAC.
    - Delay PT10S: 10-second delay so the network stack is up before enroll.
    - Arguments /background: MUST stay lowercase to match App.xaml.cs parsing.
    - StopIfGoingOnBatteries / DisallowStart... = false: run regardless of power.
    - ExecutionTimeLimit PT0S: no time limit (the Agent is long-running).
    - MultipleInstances IgnoreNew: if already running, don't spawn a duplicate.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Starts the ConnectLive Agent at user logon.</Description>
    <URI>\ConnectLiveAgent</URI>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <Delay>PT10S</Delay>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <GroupId>S-1-5-32-545</GroupId>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>__AGENT_EXE__</Command>
      <Arguments>/background</Arguments>
    </Exec>
  </Actions>
</Task>
