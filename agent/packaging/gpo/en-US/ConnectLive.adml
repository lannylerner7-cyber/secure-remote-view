<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                           revision="1.0" schemaVersion="1.0">
  <displayName>ConnectLive Policy Definitions</displayName>
  <description>ADMX policy definitions for the ConnectLive Agent.</description>
  <resources>
    <stringTable>
      <string id="CategoryConnectLive">ConnectLive</string>
      <string id="PolicyDeploymentKey">Deployment Key</string>
      <string id="PolicyDeploymentKey_Explain">Sets the enrollment bearer token that the ConnectLive Agent presents to POST /api/public/agent/enroll on first boot. Rotate this string to invalidate future enrollments without touching already-enrolled devices. Stored under HKLM\Software\Policies\ConnectLive\DeploymentKey and read by DeploymentKey.Resolve() before any local file or environment variable.</string>
    </stringTable>
  </resources>
</policyDefinitionResources>
