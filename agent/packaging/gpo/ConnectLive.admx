<?xml version="1.0" encoding="utf-8"?>
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   revision="1.0" schemaVersion="1.0">
  <policyNamespaces>
    <target prefix="connectlive" namespace="ConnectLive.Policies" />
    <using prefix="windows" namespace="Microsoft.Policies.Windows" />
  </policyNamespaces>

  <resources minRequiredRevision="1.0" />

  <categories>
    <category name="ConnectLive" displayName="$(string.CategoryConnectLive)" />
  </categories>

  <policies>
    <policy name="DeploymentKey"
            class="Machine"
            displayName="$(string.PolicyDeploymentKey)"
            explainText="$(string.PolicyDeploymentKey_Explain)"
            key="Software\Policies\ConnectLive"
            valueName="DeploymentKey">
      <parentCategory ref="ConnectLive" />
      <supportedOn ref="windows:SUPPORTED_Windows7" />
      <elements>
        <text id="DeploymentKeyText" valueName="DeploymentKey" required="true" maxLength="512" />
      </elements>
    </policy>
  </policies>
</policyDefinitions>
