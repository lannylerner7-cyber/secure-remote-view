<?xml version="1.0" encoding="UTF-8"?>
<!--
  ConnectLive Agent - per-machine WiX v4 installer (standalone, agent-only).

  There is no helper service and no installer-created autorun. The interactive
  user authorizes startup/recovery inside the Agent. Program Files updates are
  administrator-managed; the runtime updater does not elevate or loosen ACLs.

  build.ps1 injects the version:
    Build through agent/build.ps1 -Version 1.10.1.

  Silent install / upgrade:
    msiexec /i ConnectLiveAgent.msi /qn
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <?ifndef Version ?>
  <?error Supply Version through agent/build.ps1 ?>
  <?endif ?>

  <Package Name="ConnectLive Agent"
           Manufacturer="ConnectLive"
           Version="$(var.Version)"
           UpgradeCode="7f2e6b9c-9a35-4a1b-8f2d-91b0a8f8c7d1"
           Scope="perMachine"
           InstallerVersion="500">

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of ConnectLive Agent is already installed. Remove it from Apps &amp; Features before installing this build." />

    <MediaTemplate EmbedCab="yes" />

    <Feature Id="Main" Title="ConnectLive Agent" Level="1">
      <ComponentGroupRef Id="ConnectLiveComponents" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="ConnectLive" />
    </StandardDirectory>

    <!--
      ProgramData\ConnectLive stays as a legacy landing spot for install.log
      and any pre-migration device.dat. The Agent's live storage moved to
      %LOCALAPPDATA%\ConnectLive on first launch (see ApiClient.MigrateLegacyStore).
    -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="PROGRAMDATA_CONNECTLIVE" Name="ConnectLive" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="PROGRAMMENU_CONNECTLIVE" Name="ConnectLive" />
    </StandardDirectory>

    <ComponentGroup Id="ConnectLiveComponents">

      <Component Id="AgentExe" Directory="INSTALLDIR"
                 Guid="c7e4d1a2-8b3f-4c9e-9d0b-1a2b3c4d5e6f">
        <File Id="AgentExeFile"
              Source="..\..\dist\ConnectLive.exe"
              KeyPath="yes" />
        <fw:FirewallException Id="AgentOutbound"
                              Name="ConnectLive Agent (Outbound)"
                              Scope="any" Protocol="tcp" Port="443"
                              Outbound="yes" IgnoreFailure="yes" />
      </Component>

      <Component Id="WatchExe" Directory="INSTALLDIR" Guid="847d7424-dc04-49f6-9c64-bf9ce72f714b">
        <File Id="WatchExeFile" Source="..\..\dist\ConnectLiveWatch.exe" KeyPath="yes" />
      </Component>
      <Component Id="UpdateWorkerExe" Directory="INSTALLDIR" Guid="2911a2cd-df77-4d69-90ad-309e8fabfe5c">
        <File Id="UpdateWorkerExeFile" Source="..\..\dist\ConnectLiveUpdate.exe" KeyPath="yes" />
      </Component>

      <Component Id="ProgramDataDir"
                 Directory="PROGRAMDATA_CONNECTLIVE"
                 Guid="e9a6f3c4-ad5b-4e1a-bf2d-3c4d5e6f7081">
        <CreateFolder />
        <!-- Install metadata only. No installer-created autorun or service. -->
        <RegistryValue Root="HKLM"
                       Key="Software\ConnectLive"
                       Name="Installed" Type="integer" Value="1" />
        <RegistryValue Root="HKLM"
                       Key="Software\ConnectLive"
                       Name="InstallPath" Type="string" Value="[INSTALLDIR]" />
        <RegistryValue Root="HKLM"
                       Key="Software\ConnectLive"
                       Name="Version" Type="string" Value="$(var.Version)" />
        <RegistryValue Root="HKLM" Key="Software\ConnectLive"
                       Name="UninstallRequested" Type="string" Value="none" />
        <RemoveRegistryValue Id="RemoveLegacyMachineAutorun" Root="HKLM"
                             Key="Software\Microsoft\Windows\CurrentVersion\Run"
                             Name="ConnectLive" />
        <RemoveFolder Id="RemoveProgramDataDir" On="uninstall" />
      </Component>

      <Component Id="StartMenuShortcut"
                 Directory="PROGRAMMENU_CONNECTLIVE"
                 Guid="f0e4269b-7999-4f03-b2c6-067827bb8d0f">
        <Shortcut Id="ConnectLiveStartMenuShortcut"
                  Name="ConnectLive"
                  Target="[INSTALLDIR]ConnectLive.exe"
                  Description="ConnectLive pairing, status and remote-access settings" />
        <RegistryValue Root="HKLM"
                       Key="Software\ConnectLive"
                       Name="StartMenuShortcut"
                       Type="integer" Value="1"
                       KeyPath="yes" />
        <RemoveFolder Id="RemoveProgramMenuDir" On="uninstall" />
      </Component>

    </ComponentGroup>

    <!--
      Remove only legacy machine task names. Current per-user startup is
      enrolled inside the Agent; MSI never invents that authorization.
    -->
    <CustomAction Id="RemoveLogonTask"
                  Directory="INSTALLDIR"
                  ExeCommand="&quot;[System64Folder]schtasks.exe&quot; /Delete /F /TN &quot;ConnectLiveAgent&quot;"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="RemoveLegacyWatchTask" Directory="INSTALLDIR"
                  ExeCommand="&quot;[System64Folder]schtasks.exe&quot; /Delete /F /TN &quot;ConnectLiveWatch&quot;"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <!-- Explicit removal pauses all opted-in per-user companions before file
         removal. Upgrades do NOT revoke enrollment. Rollback clears the
         machine marker, but never restores a user's withdrawn authorization. -->
    <CustomAction Id="RollbackRemovalMarker" Directory="INSTALLDIR"
                  ExeCommand="&quot;[System64Folder]reg.exe&quot; ADD &quot;HKLM\Software\ConnectLive&quot; /v UninstallRequested /t REG_SZ /d none /f /reg:64"
                  Execute="rollback" Impersonate="no" Return="check" />
    <CustomAction Id="MarkRemoval" Directory="INSTALLDIR"
                  ExeCommand="&quot;[System64Folder]reg.exe&quot; ADD &quot;HKLM\Software\ConnectLive&quot; /v UninstallRequested /t REG_SZ /d &quot;[INSTALLDIR].&quot; /f /reg:64"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="WithdrawCurrentUser" FileRef="AgentExeFile" ExeCommand="/uninstall"
                  Execute="deferred" Impersonate="yes" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RemoveLogonTask"  Before="RemoveFiles"
              Condition="NOT Installed OR REMOVE=&quot;ALL&quot;" />
      <Custom Action="RemoveLegacyWatchTask" Before="RemoveLogonTask"
              Condition="NOT Installed OR REMOVE=&quot;ALL&quot;" />
      <Custom Action="WithdrawCurrentUser" Before="RemoveLegacyWatchTask"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="MarkRemoval" Before="WithdrawCurrentUser"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RollbackRemovalMarker" Before="MarkRemoval"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

  </Package>
</Wix>
