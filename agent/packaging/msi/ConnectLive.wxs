<?xml version="1.0" encoding="UTF-8"?>
<!--
  ConnectLive Agent - per-machine WiX v4 installer (standalone, agent-only).

  There is no helper service. Startup persistence is delivered by the Agent
  itself (HKCU Run key + Startup shortcut, self-healed on every launch) plus
  four autostart triggers created at install time:

    1. HKLM\Software\Microsoft\Windows\CurrentVersion\Run
    2. All-users Startup folder shortcut
    3. Per-machine ONLOGON Scheduled Task (with /IT interactive-only)
    4. Install metadata under HKLM\Software\ConnectLive

  build.ps1 injects the version:
    wix build ConnectLive.wxs -d Version=1.9.3 ...

  Silent install / upgrade:
    msiexec /i ConnectLiveAgent.msi /qn
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <?ifndef Version ?>
  <?define Version = "1.9.2" ?>
  <?endif ?>

  <Package Name="ConnectLive Agent"
           Manufacturer="ConnectLive"
           Version="$(Version)"
           UpgradeCode="7f2e6b9c-9a35-4a1b-8f2d-91b0a8f8c7d1"
           Scope="perMachine"
           InstallerVersion="500">

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of ConnectLive Agent is already installed. Remove it from Apps &amp; Features before installing this build." />

    <MediaTemplate EmbedCab="yes" />

    <Feature Id="Main" Title="ConnectLive Agent" Level="1">
      <ComponentGroupRef Id="ConnectLiveComponents" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="ConnectLive" />
    </StandardDirectory>

    <!--
      ProgramData\ConnectLive stays as a legacy landing spot for install.log
      and any pre-migration device.dat. The Agent's live storage moved to
      %LOCALAPPDATA%\ConnectLive on first launch (see ApiClient.MigrateLegacyStore).
    -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="PROGRAMDATA_CONNECTLIVE" Name="ConnectLive" />
    </StandardDirectory>

    <!-- All-users Startup folder — the shortcut is removed with its component. -->
    <StandardDirectory Id="StartupFolder">
      <Directory Id="STARTUP_CONNECTLIVE" Name="." />
    </StandardDirectory>

    <ComponentGroup Id="ConnectLiveComponents">

      <Component Id="AgentExe" Directory="INSTALLDIR"
                 Guid="c7e4d1a2-8b3f-4c9e-9d0b-1a2b3c4d5e6f">
        <File Id="AgentExeFile"
              Source="..\..\dist\ConnectLive.exe"
              KeyPath="yes" />
        <fw:FirewallException Id="AgentOutbound"
                              Name="ConnectLive Agent (Outbound)"
                              Scope="any" Protocol="tcp" Port="443"
                              Outbound="yes" IgnoreFailure="yes" />
      </Component>

      <Component Id="ProgramDataDir"
                 Directory="PROGRAMDATA_CONNECTLIVE"
                 Guid="e9a6f3c4-ad5b-4e1a-bf2d-3c4d5e6f7081">
        <CreateFolder>
          <util:PermissionEx User="SYSTEM"         GenericAll="yes" />
          <util:PermissionEx User="Administrators" GenericAll="yes" />
          <util:PermissionEx User="AuthenticatedUsers"
                             GenericRead="yes"
                             GenericWrite="yes"
                             Delete="yes" />
        </CreateFolder>
        <!-- Install metadata + machine-wide Run key. All removed on uninstall. -->
        <RegistryValue Root="HKLM"
                       Key="Software\ConnectLive"
                       Name="Installed" Type="integer" Value="1" />
        <RegistryValue Root="HKLM"
                       Key="Software\ConnectLive"
                       Name="InstallPath" Type="string" Value="[INSTALLDIR]" />
        <RegistryValue Root="HKLM"
                       Key="Software\ConnectLive"
                       Name="Version" Type="string" Value="$(Version)" />
        <RegistryValue Root="HKLM"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="ConnectLive" Type="string"
                       Value="&quot;[INSTALLDIR]ConnectLive.exe&quot; /background" />
        <RemoveFolder Id="RemoveProgramDataDir" On="uninstall" />
      </Component>

      <Component Id="StartupShortcut"
                 Directory="STARTUP_CONNECTLIVE"
                 Guid="a1b2c3d4-e5f6-7890-abcd-ef1234567890">
        <Shortcut Id="ConnectLiveStartupShortcut"
                  Name="ConnectLive"
                  Target="[INSTALLDIR]ConnectLive.exe"
                  Arguments="/background"
                  Description="ConnectLive background agent" />
        <RegistryValue Root="HKLM"
                       Key="Software\ConnectLive"
                       Name="StartupShortcut"
                       Type="integer" Value="1"
                       KeyPath="yes" />
        <RemoveFolder Id="RemoveStartupDir" On="uninstall" />
      </Component>

    </ComponentGroup>

    <!--
      Register + tear down the ONLOGON Scheduled Task via schtasks.exe.
      /IT = interactive logons only (the agent needs a desktop for capture
      and consent). /RL LIMITED + /DELAY 0000:10 keep the least-privilege,
      network-ready semantics from the Inno installer.
    -->
    <CustomAction Id="RegisterLogonTask"
                  Directory="INSTALLDIR"
                  ExeCommand="schtasks.exe /Create /F /SC ONLOGON /TN &quot;ConnectLiveAgent&quot; /TR &quot;\&quot;[INSTALLDIR]ConnectLive.exe\&quot; /background&quot; /RL LIMITED /DELAY 0000:10 /IT"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="RemoveLogonTask"
                  Directory="INSTALLDIR"
                  ExeCommand="schtasks.exe /Delete /F /TN &quot;ConnectLiveAgent&quot;"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RegisterLogonTask" After="InstallFiles"
              Condition="NOT Installed" />
      <Custom Action="RemoveLogonTask"  Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

  </Package>
</Wix>
