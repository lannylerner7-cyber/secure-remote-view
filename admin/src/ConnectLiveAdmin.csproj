<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ConnectLive.Admin</RootNamespace>
    <AssemblyName>ConnectLiveAdmin</AssemblyName>
    <!-- Prefer the admin's own icon (admin\assets\icon.ico, added manually).
         Fall back to the agent icon only when the admin one is absent. -->
    <ApplicationIcon Condition="Exists('..\assets\icon.ico')">..\assets\icon.ico</ApplicationIcon>
    <ApplicationIcon Condition="'$(ApplicationIcon)' == '' And Exists('..\..\agent\assets\icon.ico')">..\..\agent\assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Version>1.5.0</Version>
    <Company>ConnectLive</Company>
    <Product>ConnectLive Admin</Product>
    <AssemblyTitle>ConnectLive Admin</AssemblyTitle>
    <FileDescription>ConnectLive native admin console</FileDescription>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="SIPSorcery" Version="6.2.4" />
    <PackageReference Include="SIPSorceryMedia.Encoders" Version="8.0.7" />
  </ItemGroup>

  <ItemGroup>
    <None Include="admin.config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Embedded window/taskbar icon. Conditional: the .ico is dropped into
         admin\assets\ manually and the build must not fail without it.
         Consumed by ConnectLive.Admin.Ui.AppIcon. -->
    <Resource Include="..\assets\icon.ico" Link="assets\icon.ico"
              Condition="Exists('..\assets\icon.ico')" />
  </ItemGroup>


</Project>
