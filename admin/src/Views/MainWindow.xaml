<Window x:Class="ConnectLive.Admin.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ConnectLive.Admin.ViewModels"
        Title="ConnectLive Admin"
        Height="640" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimary}">
    <Window.DataContext>
        <vm:DevicesViewModel />
    </Window.DataContext>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource BgSurface}" Padding="16,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource Accent}" VerticalAlignment="Center" />
                    <TextBlock Text="ConnectLive Admin" Foreground="White" FontWeight="SemiBold"
                               Margin="8,0,16,0" VerticalAlignment="Center" />
                    <TextBlock Text="Device console" Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="Orders (web)" Click="OpenOrders_Click"
                            Background="Transparent" Foreground="{StaticResource Accent}" Margin="4,0" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="4,0" />
                    <Button Content="Sign out" Click="SignOut_Click" Background="#334155" Margin="4,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" Foreground="#F87171"
                   Padding="16,4" FontSize="11" />

        <DataGrid ItemsSource="{Binding Devices}" AutoGenerateColumns="False"
                  Background="{StaticResource BgPrimary}"
                  Foreground="White" GridLinesVisibility="None"
                  RowBackground="Transparent" AlternatingRowBackground="#0B1220"
                  BorderThickness="0" HeadersVisibility="Column"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single">
            <!-- Cells must not swallow the first click: without this the grid
                 takes the initial press for cell focus and Connect / Wake /
                 Delete appear dead until the row is already selected. -->
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="White" />
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Device" Binding="{Binding DisplayName}" Width="*" />
                <DataGridTextColumn Header="Host" Binding="{Binding Hostname}" Width="140" />
                <DataGridTextColumn Header="OS" Binding="{Binding Os}" Width="180" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen}" Width="100" />
                <DataGridTemplateColumn Header="" Width="280">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Connect"
                                        Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Wake" Background="#334155" Margin="6,0,0,0"
                                        ToolTip="Route a Wake-on-LAN magic packet through an online peer on the same subnet."
                                        Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.WakeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Delete" Background="#7F1D1D" Margin="6,0,0,0"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
