<Window x:Class="ConnectLive.Admin.Views.LiveSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live session"
        Height="760" Width="1100"
        MinHeight="480" MinWidth="720"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimary}">
    <DockPanel>
        <!-- Toolbar.
             LAYOUT INVARIANT — the action buttons are declared FIRST and
             docked above the status so they always reserve their height. The status panel
             is the fill child and trims instead of squeezing the actions off
             the edge, which is exactly what used to make every button in this
             bar unreachable. The actions live in a WrapPanel so a narrow
             window folds them onto a second line rather than clipping them. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BgSurface}" Padding="12,8">
            <DockPanel LastChildFill="True">
                <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal"
                           HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Button Content="Reconnect" Command="{Binding ReconnectAgentCommand}"
                            Background="#334155" Margin="4,2" MinWidth="88"
                            ToolTip="Wake the agent and force it to pick up this session on the next heartbeat" />
                    <Button Content="Restart stream" Command="{Binding RestartStreamCommand}"
                            Background="#334155" Margin="4,2" MinWidth="110"
                            ToolTip="Tear down and rebuild the live stream without restarting the agent process" />
                    <Button Content="Restart agent" Command="{Binding RestartAgentCommand}"
                            Background="#334155" Margin="4,2" MinWidth="104"
                            ToolTip="Soft-restart the agent in place (falls back to relaunch if the reset fails)" />
                    <Button Content="{Binding ControlButtonLabel}" Command="{Binding ToggleControlCommand}"
                            Background="#7F1D1D" Margin="4,2" MinWidth="150"
                            ToolTip="Take control: blocks the user's keyboard/mouse, shows the curtain, and routes your real mouse and keyboard to the remote machine" />

                    <!-- Fit / 1:1 view mode. Fit lets the picture fill the
                         window (upscale allowed); 1:1 shows native pixels in a
                         scroll viewer. ContentRect reads allowUpscale off the
                         Image's live StretchDirection, so input geometry stays
                         correct in both modes without extra bookkeeping. -->
                    <ToggleButton x:Name="OneToOneToggle" Content="1:1" Margin="4,2" MinWidth="52"
                                  Padding="12,6" BorderThickness="0" Foreground="White"
                                  Background="#334155" Cursor="Hand"
                                  Checked="ViewMode_Changed" Unchecked="ViewMode_Changed"
                                  ToolTip="Toggle between Fit (scale the desktop to this window) and 1:1 (native pixels, scrollable)" />

                    <!-- Step 9 — slide-out session files panel. -->
                    <ToggleButton IsChecked="{Binding FilesPanelOpen}" Content="Files" Margin="4,2" MinWidth="64"
                                  Padding="12,6" BorderThickness="0" Foreground="White"
                                  Background="#334155" Cursor="Hand"
                                  ToolTip="Open the session file manager (upload, download and manage files)" />

                    <!-- S19(b) — pointer capture. Locks the local cursor to the
                         live surface and streams relative motion, so the remote
                         pointer is unbounded and 1:1 with the hand. -->
                    <ToggleButton x:Name="CaptureToggle" Content="Capture" Margin="4,2" MinWidth="76"
                                  Padding="12,6" BorderThickness="0" Foreground="White"
                                  Background="#334155" Cursor="Hand"
                                  Checked="Capture_Changed" Unchecked="Capture_Changed"
                                  ToolTip="Capture the pointer (relative motion, unbounded). Press Esc or F8 to release." />


                    <!-- Power actions collapsed behind one menu so the bar
                         stays inside a normal window width. -->
                    <Menu Background="Transparent" VerticalAlignment="Center" Margin="4,2">
                        <MenuItem Header="Power" Foreground="White" Padding="12,6"
                                  ToolTip="Lock, restart or shut down the remote machine">
                            <MenuItem Header="Lock" Command="{Binding PowerCommandCommand}" CommandParameter="lock" />
                            <MenuItem Header="Restart" Command="{Binding PowerCommandCommand}" CommandParameter="reboot" />
                            <MenuItem Header="Shut down" Command="{Binding PowerCommandCommand}" CommandParameter="shutdown" />
                        </MenuItem>
                    </Menu>

                    <!-- S18 — one-click capture of the render/transport reading
                         so a real-session measurement can be pasted back. -->
                    <Button Content="Copy stats" Command="{Binding CopyDiagnosticsCommand}"
                            Background="#334155" Margin="4,2" MinWidth="90"
                            ToolTip="Copy the full fps / bitrate / latency / path reading for this session to the clipboard" />

                    <!-- S22 — push this machine's clipboard to the remote desktop. -->
                    <Button Content="Send clipboard" Command="{Binding SendClipboardCommand}"
                            Background="#334155" Margin="4,2" MinWidth="110"
                            ToolTip="Copy the local clipboard text to the remote machine over the encrypted clip channel" />

                    <!-- S24 — tee the decoded video stream to an .ivf file. -->
                    <Button Content="{Binding RecordLabel}" Command="{Binding ToggleRecordingCommand}"
                            Margin="4,2" MinWidth="110"
                            ToolTip="Record the live stream to Videos\ConnectLive (no re-encode, no extra bandwidth)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="#334155" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="Background" Value="#B91C1C" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>


                    <Button Content="End session" Click="EndSession_Click"
                            Background="#334155" Margin="4,2" MinWidth="96" />

                </WrapPanel>

                <!-- Fill child: status readouts. Clipped, never expanding past
                     the space the actions left behind. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            ClipToBounds="True" Margin="0,0,12,0">
                    <Ellipse Width="8" Height="8" Fill="#22C55E" VerticalAlignment="Center" />
                    <TextBlock Text="LIVE" Foreground="White" FontWeight="Bold" Margin="8,0,16,0"
                               VerticalAlignment="Center" FontSize="11" />
                    <TextBlock x:Name="DeviceLabel" Foreground="White" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="180" />
                    <TextBlock Text="•" Foreground="{StaticResource TextMuted}" Margin="8,0" VerticalAlignment="Center" />
                    <!-- Pill honesty: green only while decoded frames present. -->
                    <TextBlock Text="{Binding Transport}" VerticalAlignment="Center" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NativeVideo}" Value="True">
                                        <Setter Property="Foreground" Value="#22C55E" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="•" Foreground="{StaticResource TextMuted}" Margin="8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LinkState}" Foreground="#22C55E"
                               VerticalAlignment="Center" FontSize="11"
                               TextTrimming="CharacterEllipsis" MaxWidth="220" />
                    <!-- S18 HUD: fps / bitrate / latency / queue / drops / source size.
                         Widened for the two extra fields; still trimmed, never
                         allowed to push the docked actions off the bar. -->
                    <TextBlock Text="{Binding VideoStats}" Foreground="{StaticResource TextMuted}"
                               Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11"
                               TextTrimming="CharacterEllipsis" MaxWidth="560"

                               ToolTip="{Binding VideoStats}" />

                    <!-- SCOPE:CAPTURE — monitor picker. Hidden on single-display
                         machines so the bar stays clean. -->
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMultipleMonitors}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Display" Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0" />
                        <ComboBox MinWidth="160"
                                  ItemsSource="{Binding Monitors}"
                                  SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
                                  DisplayMemberPath="Label"
                                  VerticalAlignment="Center"
                                  ToolTip="Choose which remote monitor is captured. The stream restarts on change." />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Banners are docked ABOVE the picture, not overlaid on it: a
             take-over notice or an RLS warning must never cover the top of the
             remote desktop. Collapsed banners take no layout space. -->
        <Border DockPanel.Dock="Top" Background="#DC2626" Padding="16,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TakenOver}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding TakenOverMessage}" Foreground="White"
                       FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
        </Border>

        <!-- Non-fatal background error banner (frame poll / signal poll / RLS 401). -->
        <Border DockPanel.Dock="Top" Background="#F59E0B" Padding="12,6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}" Foreground="Black" FontWeight="SemiBold"
                       TextAlignment="Center" TextWrapping="Wrap" />
        </Border>

        <!-- The live surface. Keyboard interception is scoped to this element
             (Stage) so toolbar buttons keep normal Tab/Enter/Space behaviour. -->
        <!-- Stage-level mouse handlers exist for S19(b): while the pointer is
             captured, WPF routes every mouse event to the capturing element
             (Stage), so the Image handlers below never fire. Each Stage
             handler is a no-op unless capture is engaged, so nothing
             double-fires in normal mode. -->
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="ViewerHost" Grid.Column="0" Margin="16">
        <Grid x:Name="Stage" Background="Black" UseLayoutRounding="True" SnapsToDevicePixels="True"
              Width="{Binding ActualWidth, ElementName=ViewerHost}"
              Height="{Binding ActualHeight, ElementName=ViewerHost}"
              MaxWidth="960" MaxHeight="540"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Focusable="True" FocusVisualStyle="{x:Null}"
              MouseMove="Stage_MouseMove"
              MouseLeftButtonDown="Stage_MouseDown"
              MouseLeftButtonUp="Stage_MouseUp"
              MouseRightButtonDown="Stage_MouseRightDown"
              MouseRightButtonUp="Stage_MouseRightUp"
              MouseWheel="Stage_MouseWheel">

            <ScrollViewer x:Name="FrameScroll"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Disabled"
                          PanningMode="None" Focusable="False" Background="Black">
                <!-- HighQuality (Fant) is the correct downscale filter for remote
                     desktop text; the default bilinear pass smears 1920px sources
                     into a ~1100px element. Fit mode allows upscale so a small
                     rung fills the window; 1:1 mode swaps to native pixels. -->
                <Image x:Name="FrameImage" Source="{Binding CurrentFrame}"
                       Stretch="Uniform" StretchDirection="Both"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       UseLayoutRounding="True" SnapsToDevicePixels="True"
                       MouseMove="Frame_MouseMove"
                       MouseLeftButtonDown="Frame_MouseDown"
                       MouseLeftButtonUp="Frame_MouseUp"
                       MouseRightButtonDown="Frame_MouseRightDown"
                       MouseRightButtonUp="Frame_MouseRightUp"
                       MouseWheel="Frame_MouseWheel" />
            </ScrollViewer>

            <!-- Ghost cursor overlay driven by CursorPollPump. Positions are
                  computed through ContentRect against FrameImage, so it tracks
                  letterboxing in Fit mode and scroll offset in 1:1 mode. -->
            <Canvas x:Name="CursorLayer" IsHitTestVisible="False">
                <Path x:Name="CursorGhost" Fill="#F97316" Stroke="Black" StrokeThickness="1"
                      Visibility="Collapsed"
                      Data="M0,0 L0,14 L4,10 L6,14 L8,13 L6,9 L11,9 Z" />
            </Canvas>
        </Grid>
        </Grid>

        <!-- Step 9 — Session file manager (slide-out, right-side panel). -->
        <Border Grid.Column="1" Width="340" Background="{StaticResource BgSurface}"
                BorderBrush="#334155" BorderThickness="1,0,0,0" Padding="12"
                Visibility="{Binding FilesPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Session files" Foreground="White" FontWeight="SemiBold"
                           FontSize="14" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="1" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,8">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0:N0} bytes used">
                            <Binding Path="SessionBytesUsed"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>

                <!-- Password unlock for zip downloads. -->
                <StackPanel Grid.Row="2" Margin="0,0,0,8">
                    <TextBlock Text="Zip download password" Foreground="White" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding PasswordEmail, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Customer account email address"
                             Margin="0,2" Padding="6,4" FontSize="11">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Tag" Value="email@example.com"/>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <PasswordBox x:Name="ZipPasswordBox" Margin="0,2" Padding="6,4" FontSize="11"
                                 PasswordChanged="ZipPassword_Changed" ToolTip="Customer account password"/>
                    <Button Content="Unlock zip downloads" Command="{Binding UnlockPasswordCommand}"
                            Margin="0,4,0,0" Padding="8,4" Background="#334155" Foreground="White"
                            IsEnabled="{Binding HasCachedPassword, Converter={StaticResource InverseBooleanConverter}}"/>
                    <TextBlock Text="Zip downloads are unlocked" Foreground="#22C55E" FontSize="11"
                               Visibility="{Binding HasCachedPassword, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- File list. -->
                <Border Grid.Row="3" BorderBrush="#334155" BorderThickness="1" Background="#0B1120" Margin="0,0,0,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Files}" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Vertical">
                                            <TextBlock Text="{Binding Name}" Foreground="White" TextTrimming="CharacterEllipsis" FontSize="11"
                                                       ToolTip="{Binding Name}"/>
                                            <TextBlock FontSize="10" Foreground="{StaticResource TextMuted}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} • {1:N0} bytes">
                                                        <Binding Path="Direction"/>
                                                        <Binding Path="SizeBytes"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="×" Padding="4,0" Background="Transparent" BorderThickness="0"
                                                Foreground="#F87171" FontSize="14" VerticalAlignment="Center"
                                                Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Id}" ToolTip="Delete"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <TextBlock Grid.Row="4" Text="{Binding FilesStatus}" Foreground="{StaticResource TextMuted}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding FilesStatus, Converter={StaticResource NullToVisibilityConverter}}"/>

                <WrapPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Stretch">
                    <Button Content="Send files…" Command="{Binding SendFilesCommand}" Padding="10,5"
                            Background="#2563EB" Foreground="White" Margin="0,2,6,2"
                            ToolTip="Select a file and push it to the remote machine"/>
                    <Button Content="Download zip" Command="{Binding DownloadZipCommand}" Padding="10,5"
                            Background="#334155" Foreground="White" Margin="0,2,6,2"
                            ToolTip="Create an AES-256 encrypted zip of the selected files"/>
                    <Button Content="Refresh" Command="{Binding RefreshFilesCommand}" Padding="10,5"
                            Background="#334155" Foreground="White" Margin="0,2,0,2"
                            ToolTip="Refresh the file list"/>
                </WrapPanel>
            </Grid>
        </Border>
        </Grid>
    </DockPanel>
</Window>
