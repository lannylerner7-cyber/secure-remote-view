<Window x:Class="ConnectLive.Admin.Views.LiveSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live session"
        Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimary}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource BgSurface}" Padding="12,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#22C55E" VerticalAlignment="Center" />
                    <TextBlock Text="LIVE" Foreground="White" FontWeight="Bold" Margin="8,0,16,0"
                               VerticalAlignment="Center" FontSize="11" />
                    <TextBlock x:Name="DeviceLabel" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text="•" Foreground="{StaticResource TextMuted}" Margin="8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Transport}" Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="Take control" Command="{Binding TogglePauseCommand}" Margin="4,0" />
                    <Button Content="Curtain" Command="{Binding ToggleCurtainCommand}"
                            Background="#7F1D1D" Margin="4,0" />
                    <Button Content="End session" Click="EndSession_Click"
                            Background="#334155" Margin="4,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Background="Black">
            <Image x:Name="FrameImage" Source="{Binding CurrentFrame}"
                   Stretch="Uniform"
                   MouseMove="Frame_MouseMove"
                   MouseLeftButtonDown="Frame_MouseDown"
                   MouseLeftButtonUp="Frame_MouseUp"
                   MouseRightButtonDown="Frame_MouseRightDown"
                   MouseRightButtonUp="Frame_MouseRightUp"
                   MouseWheel="Frame_MouseWheel" />
            <!-- Take-over banner: red overlay when another admin console
                 supersedes this session (WebRtcClient "terminated" signal). -->
            <Border Background="#DC2626" Padding="16,10"
                    VerticalAlignment="Top" HorizontalAlignment="Stretch">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TakenOver}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding TakenOverMessage}" Foreground="White"
                           FontWeight="SemiBold" TextAlignment="Center" />
            </Border>

            <!-- Non-fatal background error banner (frame poll / signal poll / RLS 401). -->
            <Border Background="#F59E0B" Padding="12,6"
                    VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0,64,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusMessage}" Foreground="Black" FontWeight="SemiBold" TextAlignment="Center" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
